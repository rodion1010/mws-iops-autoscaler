# Template for .env — copy to .env and fill in. .env itself is gitignored.
#   cp .env.example .env
#   set -a; source .env; set +a

# --- MWS project / service account ---
MWS_PROJECT=<project-name>
MWS_ZONE=ru-central1-a
MWS_BASE_ENDPOINT=https://api.mwsapis.ru
MWS_COMPUTE_ENDPOINT=https://compute.mwsapis.ru
MWS_MONITORING_ENDPOINT=https://monitoring.mwsapis.ru

MWS_SERVICE_ACCOUNT=iam/projects/<project-name>/serviceAccounts/<sa-name>
MWS_SERVICE_ACCOUNT_AUTHORIZED_KEY_PATH=./secrets/mws-sa-key.json

# mws CLI profile to use (see: mws profile list)
MWS_CLI_PROFILE=<profile-name>

# The SDK/CLI default of 5s is too low when endpoint discovery is slow.
MWS_TIMEOUT=60s

# --- SSH access to test VMs ---
# Public keys injected into test VMs at creation.
SSH_PUBKEY_RODION="ssh-ed25519 AAAA... user@host"
SSH_PUBKEY_CLAUDE="ssh-ed25519 AAAA... claude@mws-iops-autoscaler"
SSH_PRIVKEY_CLAUDE=./secrets/id_ed25519

# Login user created via cloud-init (admin/root are rejected by MWS)
SSH_USER=<username>
